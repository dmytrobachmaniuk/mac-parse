# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Моделі по черзі: коли в однієї закінчилась денна квота — бот бере наступну
GEMINI_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_THINKING=low
# Запитів до Gemini на хвилину і максимум аналізів за один скан
GEMINI_RPM=8
MAX_ANALYZE_PER_SCAN=200
PHOTOS_FOR_AI=10

# Як часто сканувати OLX (хв)
SCAN_INTERVAL_MIN=30
# Межі ціни в гривнях: дешевше — майже завжди аксесуар/скам/запчастини
MIN_PRICE_UAH=12000
MAX_PRICE_UAH=80000
# Пуш про нове оголошення, якщо AI поставив від цього балу (1..10)
# Розділ «Найкраще ціна/якість»: оголошення з оцінкою Gemini від цього балу
BEST_MIN_SCORE=7
NOTIFY_MIN_SCORE=8
MAX_AGE_DAYS=37
# Через кому: @username або числові Telegram id, яким дозволено користуватись ботом (порожньо — всім)
ALLOWED_USER_IDS=
# Курс для оголошень у доларах
USD_UAH_RATE=41.5
