# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Запитів до Gemini на хвилину і максимум аналізів за один скан
GEMINI_RPM=8
MAX_ANALYZE_PER_SCAN=40
PHOTOS_FOR_AI=4

# Як часто сканувати OLX (хв)
SCAN_INTERVAL_MIN=30
# Межі ціни в гривнях: дешевше — майже завжди аксесуар/скам/запчастини
MIN_PRICE_UAH=12000
MAX_PRICE_UAH=80000
# Пуш про нове оголошення, якщо AI поставив від цього балу (1..10)
NOTIFY_MIN_SCORE=8
# Через кому: @username або числові Telegram id, яким дозволено користуватись ботом (порожньо — всім)
ALLOWED_USER_IDS=
# Курс для оголошень у доларах
USD_UAH_RATE=41.5
